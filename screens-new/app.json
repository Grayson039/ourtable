{
  "expo": {
    "name": "Our Table",
    "slug": "our-table",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "our-table",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ourtable.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ourtable.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OurTable uses your camera to scan fridge contents and import recipes from social media."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d82d2f2f-8f53-4a9c-82e9-045cab329032"
      }
    }
  }
}
